# kernel.fl — Kestrel, the MerlinOS kernel
# Entry point called directly by boot.s (no libc, no _flr_* runtime,
# nothing but what kstd.fl provides). boot.s now passes the multiboot
# magic and info pointer as real args (Falcon functions take normal
# params fine, main() is no exception -- no more stashing them in
# globals for us to __peek() back out).

import "kstd"
import "kmalloc"
import "vga"
import "interrupts"
import "pic"
import "keyboard"
import "pmm"
import "vmm"

func main(mb_magic: int, mb_info: int) -> void {
    kheap_init()
    vga_clear()
    interrupts_init()
    keyboard_init()

    vga_set_color(0x0F)
    vga_print("MerlinOS\n")
    vga_set_color(0x07)
    vga_print("Kestrel kernel -- stage 5\n\n")

    vga_set_color(0x0A)
    vga_print("[ok] VGA text driver\n")
    vga_print("[ok] kernel heap at ")
    vga_print_hex(0x00400000)
    vga_print("\n")

    nums: [int] = [10, 20, 30, 40]
    sum: int = 0
    i: int = 0
    while (i < 4) {
        sum += nums[i]
        i += 1
    }
    vga_set_color(0x0F)
    vga_print("[ok] heap alloc + array test, sum = ")
    vga_print_dec(sum)
    vga_print("\n")

    # prove kmalloc/kfree actually reuse memory, not just hand out
    # fresh addresses forever like the old bump allocator did
    a: int = kmalloc(64)
    b: int = kmalloc(64)
    kfree(a)
    c: int = kmalloc(64)
    vga_print("[ok] kmalloc/kfree: a=")
    vga_print_hex(a)
    vga_print(" b=")
    vga_print_hex(b)
    vga_print(" c=")
    vga_print_hex(c)
    if (c == a) {
        vga_print(" (c reused a's block)\n")
    } else {
        vga_set_color(0x0E)
        vga_print(" (!! expected c == a, no reuse happened)\n")
        vga_set_color(0x0F)
    }
    kfree(b)
    kfree(c)

    gdt_init()
    vga_set_color(0x0A)
    vga_print("[ok] GDT loaded\n")

    idt_init()
    vga_print("[ok] IDT loaded, 48 vectors installed\n")

    paging_init()
    vga_print("[ok] paging enabled, 0-16 MiB identity-mapped\n")

    pic_remap()
    vga_print("[ok] PIC remapped to 0x20-0x2F\n")

    pit_init(100)
    vga_print("[ok] PIT set to 100 Hz\n")

    __sti()
    vga_print("[ok] interrupts enabled\n")

    if (mb_magic != 0x2BADB002) {
        vga_set_color(0x0E)
        vga_print("[!!] bad multiboot magic ")
        vga_print_hex(mb_magic)
        vga_print(" -- not booted via GRUB/multiboot?\n")
    }

    highest: int = pmm_init(mb_info)
    vga_set_color(0x0A)
    if (highest == 0) {
        vga_set_color(0x0E)
        vga_print("[!!] no multiboot memory map -- used mem_upper fallback\n")
        vga_set_color(0x0A)
    }
    vga_print("[ok] PMM initialised, ")
    vga_print_dec(g_pmm_total_pages)
    vga_print(" pages total, ")
    vga_print_dec(g_pmm_free_pages)
    vga_print(" free (")
    vga_print_dec(g_pmm_free_pages * 4 / 1024)
    vga_print(" MiB)\n")

    # paging.s only identity-mapped the first 16 MiB at boot -- now
    # that the PMM knows the real amount of RAM, extend the identity
    # map to cover all of it (page tables for the new range come from
    # pmm_alloc_frame(), still capped to the original 16 MiB pool at
    # this point -- see vmm.fl). Only then is it safe to let
    # pmm_alloc_frame() hand out anything past 16 MiB.
    true_highest: int = g_pmm_total_pages * 4096
    if (true_highest > 0x01000000) {
        vmm_identity_map_region(0x01000000, true_highest - 0x01000000)
        g_pmm_map_limit_pages = g_pmm_total_pages
        vga_print("[ok] VMM extended identity map to ")
        vga_print_dec(true_highest / 1024 / 1024)
        vga_print(" MiB, ")
        vga_print_dec(g_pmm_map_limit_pages)
        vga_print(" pages now allocatable\n")
    }

    # sanity check: alloc a couple of frames, confirm they're distinct
    # and marked used, then give one back
    f1: int = pmm_alloc_frame()
    f2: int = pmm_alloc_frame()
    vga_set_color(0x0F)
    vga_print("[ok] pmm_alloc_frame -> ")
    vga_print_hex(f1)
    vga_print(", ")
    vga_print_hex(f2)
    vga_print("\n")
    pmm_free_frame(f1)

    # prove the extended mapping is real, not just "trust me" -- test
    # a specific address well above the old 16 MiB ceiling directly.
    # (pmm_alloc_frame() is first-fit from page 0, so with this much
    # free low memory it would essentially never wander up here on
    # its own to exercise this path.)
    if (true_highest > 0x02100000) {
        probe: int = 0x02000000   # 32 MiB
        __poke(probe, 0xDEADBEEF)
        readback: int = __peek(probe)
        vga_print("[ok] wrote+read ")
        vga_print_hex(probe)
        vga_print(" (above old 16 MiB cap) -> ")
        vga_print_hex(readback)
        vga_print("\n")
    }

    vga_set_color(0x08)
    vga_print("\ntype something:\n")
    vga_set_color(0x0F)

    while (true) {
        __hlt()
    }
}
