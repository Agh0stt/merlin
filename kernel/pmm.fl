# pmm.fl — physical memory manager
#
# Parses the multiboot memory map (passed in as mb_info, the pointer
# boot.s receives in %ebx and now forwards as main()'s second arg)
# into a page-frame bitmap: 1 bit per 4 KiB physical page, 1 = used.
#
# The bitmap itself is allocated with _flr_alloc, i.e. it lives inside
# kstd.fl's bump heap (physical 0x400000-0x800000). That heap region,
# the first 1 MiB (real-mode area / BIOS data / VGA text buffer), and
# a generous ceiling for the kernel image are all marked permanently
# used below, independent of what the BIOS memory map claims, so
# pmm_alloc_frame() can never hand out a frame something else already
# owns. There's no virtual memory yet -- physical == virtual until
# paging exists -- so this bitmap is the entire memory-safety story
# for now.

g_pmm_bitmap: int = 0
g_pmm_total_pages: int = 0
g_pmm_free_pages: int = 0

g_pmm_reserved_low: int = 0x00100000    # below this: BIOS/real-mode/VGA, always reserved
g_pmm_kernel_end: int = 0x00300000      # generous ceiling for the kernel image itself
g_pmm_heap_start: int = 0x00400000      # must match kstd.fl's KHEAP_START
g_pmm_heap_end: int = 0x00800000        # must match kstd.fl's KHEAP_END

# paging.s currently identity-maps only 0-16 MiB (4 page tables). Until
# there's a real VMM that can map additional frames on demand,
# pmm_alloc_frame() must never hand out anything above that or the
# very next write to it page-faults. Detected RAM can be (and here,
# is) much larger than this -- g_pmm_total_pages/free_pages still
# reflect the true physical size for the boot banner, only allocation
# is capped.
g_pmm_map_limit_pages: int = 4096       # 16 MiB / 4 KiB

func pmm_bit_mask(bit: int) -> int {
    mask: int = 1
    i: int = 0
    while (i < bit) {
        mask = mask * 2
        i += 1
    }
    return mask
}

func pmm_set_bit(page: int) -> void {
    idx: int = page / 32
    bit: int = page % 32
    word: int = __peek(g_pmm_bitmap + idx * 4)
    __poke(g_pmm_bitmap + idx * 4, word | pmm_bit_mask(bit))
}

func pmm_clear_bit(page: int) -> void {
    idx: int = page / 32
    bit: int = page % 32
    word: int = __peek(g_pmm_bitmap + idx * 4)
    __poke(g_pmm_bitmap + idx * 4, word & ~pmm_bit_mask(bit))
}

func pmm_test_bit(page: int) -> bool {
    idx: int = page / 32
    bit: int = page % 32
    word: int = __peek(g_pmm_bitmap + idx * 4)
    return (word & pmm_bit_mask(bit)) != 0
}

func pmm_mark_used(page: int) -> void {
    if (page < 0) { return }
    if (page >= g_pmm_total_pages) { return }
    if (not pmm_test_bit(page)) {
        pmm_set_bit(page)
        g_pmm_free_pages -= 1
    }
}

func pmm_mark_free(page: int) -> void {
    if (page < 0) { return }
    if (page >= g_pmm_total_pages) { return }
    if (pmm_test_bit(page)) {
        pmm_clear_bit(page)
        g_pmm_free_pages += 1
    }
}

func pmm_mark_used_range(addr: int, len: int) -> void {
    start_page: int = addr / 4096
    end_page: int = (addr + len + 4095) / 4096
    p: int = start_page
    while (p < end_page) {
        pmm_mark_used(p)
        p += 1
    }
}

func pmm_mark_free_range(addr: int, len: int) -> void {
    start_page: int = (addr + 4095) / 4096
    end_page: int = (addr + len) / 4096
    p: int = start_page
    while (p < end_page) {
        pmm_mark_free(p)
        p += 1
    }
}

# Returns the highest usable physical address the multiboot mmap
# reports, or 0 if there's no mmap (flags bit 6 unset).
func pmm_scan_highest(mb_info: int) -> int {
    flags: int = __peek(mb_info)
    highest: int = 0
    if ((flags & 0x40) == 0) {
        return 0
    }
    mmap_len: int = __peek(mb_info + 44)
    mmap_addr: int = __peek(mb_info + 48)
    entry: int = mmap_addr
    end: int = mmap_addr + mmap_len
    while (entry < end) {
        size: int = __peek(entry)
        base_low: int = __peek(entry + 4)
        base_high: int = __peek(entry + 8)
        len_low: int = __peek(entry + 12)
        len_high: int = __peek(entry + 16)
        if (base_high == 0) {
            if (len_high == 0) {
                top: int = base_low + len_low
                if (top > highest) {
                    highest = top
                }
            }
        }
        entry = entry + size + 4
    }
    return highest
}

func pmm_apply_mmap(mb_info: int) -> void {
    flags: int = __peek(mb_info)
    mmap_len: int = __peek(mb_info + 44)
    mmap_addr: int = __peek(mb_info + 48)
    entry: int = mmap_addr
    end: int = mmap_addr + mmap_len
    while (entry < end) {
        size: int = __peek(entry)
        base_low: int = __peek(entry + 4)
        base_high: int = __peek(entry + 8)
        len_low: int = __peek(entry + 12)
        len_high: int = __peek(entry + 16)
        type: int = __peek(entry + 20)
        if (type == 1) {
            if (base_high == 0) {
                if (len_high == 0) {
                    pmm_mark_free_range(base_low, len_low)
                }
            }
        }
        entry = entry + size + 4
    }
}

# Returns highest usable address found (0 if the fallback path was
# used), purely for the boot-time diagnostic print.
func pmm_init(mb_info: int) -> int {
    highest: int = pmm_scan_highest(mb_info)
    used_fallback: bool = false

    if (highest == 0) {
        # no mmap -- fall back to mem_upper (flags bit 0), which is
        # KiB of RAM above 1 MiB. Conservative but always present on
        # anything that speaks multiboot.
        flags: int = __peek(mb_info)
        if ((flags & 0x01) != 0) {
            mem_upper: int = __peek(mb_info + 8)
            highest = 0x00100000 + mem_upper * 1024
        } else {
            highest = 0x01000000   # 16 MiB, pulled out of thin air
        }
        used_fallback = true
    }

    total_pages: int = highest / 4096
    bitmap_bytes: int = (total_pages + 7) / 8
    bitmap_words: int = (bitmap_bytes + 3) / 4

    g_pmm_bitmap = _flr_alloc(bitmap_words * 4)
    g_pmm_total_pages = total_pages
    g_pmm_free_pages = 0

    # start with everything reserved
    i: int = 0
    while (i < bitmap_words) {
        __poke(g_pmm_bitmap + i * 4, 0xFFFFFFFF)
        i += 1
    }

    if (used_fallback) {
        # no real mmap to trust -- just free everything above 1 MiB
        # and let the explicit reservations below claw back what we
        # actually use.
        pmm_mark_free_range(0x00100000, highest - 0x00100000)
    } else {
        pmm_apply_mmap(mb_info)
    }

    # claw back regions we use regardless of what the mmap says
    pmm_mark_used_range(0, g_pmm_reserved_low)
    pmm_mark_used_range(g_pmm_reserved_low, g_pmm_kernel_end - g_pmm_reserved_low)
    pmm_mark_used_range(g_pmm_heap_start, g_pmm_heap_end - g_pmm_heap_start)

    if (used_fallback) {
        return 0
    }
    return highest
}

func pmm_alloc_frame() -> int {
    limit: int = g_pmm_total_pages
    if (g_pmm_map_limit_pages < limit) {
        limit = g_pmm_map_limit_pages
    }
    i: int = 0
    while (i < limit) {
        if (not pmm_test_bit(i)) {
            pmm_set_bit(i)
            g_pmm_free_pages -= 1
            return i * 4096
        }
        i += 1
    }
    return -1
}

func pmm_free_frame(addr: int) -> void {
    pmm_mark_free(addr / 4096)
}
