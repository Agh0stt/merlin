# kstd.fl — MerlinOS kernel standard library: string/mem helpers.
#
# The actual heap (_flr_alloc/_flr_free, called automatically by the
# compiler wherever `[T]` or a struct needs backing memory) lives in
# kmalloc.fl now, not here -- see that file for why the original bump
# allocator got replaced with a real free-list one.

func kstrlen(s: int) -> int {
    i: int = 0
    while (__peekb(s + i) != 0) {
        i += 1
    }
    return i
}

func kstreq(a: int, b: int) -> bool {
    i: int = 0
    while (true) {
        ca: int = __peekb(a + i)
        cb: int = __peekb(b + i)
        if (ca != cb) { return false }
        if (ca == 0) { return true }
        i += 1
    }
    return true
}

func kmemset(dst: int, val: int, n: int) -> void {
    # NOTE: the __memset intrinsic calls out to _flr_memset, which only
    # exists in the hosted runtime (flr.o) -- unavailable in
    # --freestanding, so this is a plain byte loop instead.
    i: int = 0
    while (i < n) {
        __pokeb(dst + i, val)
        i += 1
    }
}

func kmemcpy(dst: int, src: int, n: int) -> void {
    # same story as kmemset -- __memcpy needs _flr_memcpy, not present
    # in freestanding mode.
    i: int = 0
    while (i < n) {
        __pokeb(dst + i, __peekb(src + i))
        i += 1
    }
}
